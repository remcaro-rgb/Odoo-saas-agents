{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "glm-5.1": { "name": "GLM-5.1" },
        "qwen3.6-plus": { "name": "Qwen 3.6 Plus" }
      }
    },
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" },
      "models": {
        "claude-sonnet-4-6": { "name": "Claude Sonnet (frontier - hard-task escalation)" }
      }
    }
  },
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/glm-5.1",
  "permission": {
    "edit": {
      "*": "allow",
      "infra/**": "deny",
      ".github/workflows/**": "deny",
      "Dockerfile": "deny",
      "**/Dockerfile": "deny",
      "saas_tenant_gate/security/**": "deny"
    },
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {}
}
