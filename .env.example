# ---------------------------------------------------------------------------
# Secrets for the Implementation Agent.
# Copy to `.env` for local use, OR set them as Fly secrets
# (`fly secrets set NAME=value`) for the deployed service.
# A filled-in `.env` is git-ignored — never commit real values.
# ---------------------------------------------------------------------------

# OpenCode Go subscription key — the model provider for routine work.
# Get it: sign in at https://opencode.ai/zen , subscribe to "Go", copy the key.
OPENCODE_GO_API_KEY=

# Frontier model key — used for hard-task escalation (plan decision 6).
# Get it: https://console.anthropic.com  ->  API keys.
ANTHROPIC_API_KEY=

# HTTP Basic password protecting the headless OpenCode server.
# Choose any strong random string; the orchestrator authenticates with it.
OPENCODE_SERVER_PASSWORD=

# Fly.io API token — only needed to DEPLOY the OpenCode service.
# Get it: `fly tokens create deploy`.
FLY_API_TOKEN=

# Where the orchestrator / smoke test reaches the OpenCode server.
# Local: http://127.0.0.1:4096 . Deployed: https://<your-fly-app>.fly.dev
OPENCODE_BASE_URL=http://127.0.0.1:4096
